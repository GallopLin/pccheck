+                            self.scaler.update()
+                            optimizer_was_run = scale_before <= self.scaler.get_scale()
+                        else:
+                            self.optimizer.step()
+                            optimizer_was_run = not self.accelerator.optimizer_step_was_skipped
+                        if optimizer_was_run:
+                            if not isinstance(self.lr_scheduler,
+                                              torch.optim.lr_scheduler.ReduceLROnPlateau):
+                                self.lr_scheduler.step()
+                            dcp_ctx.save(step)
+                            steps_since_checkp = 0
+                            _step_is_ckpt = True
+                            checkpoints += 1
+                    elif should_enter_checkpoint_block:
                         if self.cfreq > 0:
                             # 初始化 MultiStreamCheckpoint（如果还没初始化）
                             if ms_checkpoint is None:
@@ -2602,6 +2715,8 @@ class MultistreamTrainer:
             if ms_checkpoint is not None:
                 ms_checkpoint.drain()
                 ms_checkpoint.shutdown()
