+            tensor.numel() * tensor.element_size()
+            for state_part in (weights, exp_avg, exp_avg_sq)
+            for tensor in state_part.values()
+        )
+        return {
+            f"rank_{self.rank:05d}": {
+                "weights": weights,
+                "exp_avg": exp_avg,
+                "exp_avg_sq": exp_avg_sq,
