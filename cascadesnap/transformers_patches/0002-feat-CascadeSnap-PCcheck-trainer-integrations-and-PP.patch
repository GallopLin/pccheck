+class AsyncDCPManager:
+    """Official async DCP semantics, with a PyTorch-2.1 compatibility shim.
+
+    PyTorch 2.4's async_save performs synchronous GPU->CPU staging followed by
+    a background DCP save.  The production PP environment is PyTorch 2.1.2,
+    where async_save is absent, so the compatibility path reproduces exactly
+    that split while still using DCP's FileSystemWriter/save_state_dict.
+    """
+
+    def __init__(self, model_engine, checkpoint_dir, max_async=1, thread_count=1):
+        from torch.distributed.checkpoint import FileSystemWriter, save_state_dict
+
+        self.model_engine = model_engine
+        self.checkpoint_dir = checkpoint_dir
+        self.rank = torch.distributed.get_rank()
+        self.world_size = torch.distributed.get_world_size()
+        self.max_async = max(1, int(max_async))
+        self.thread_count = max(1, int(thread_count))
+        self.FileSystemWriter = FileSystemWriter
+        self.save_state_dict = save_state_dict
+        self.process_group = torch.distributed.new_group(backend="gloo")
+        self.executor = ThreadPoolExecutor(max_workers=1, thread_name_prefix="dcp_save")
+        self.pending = []
+        self.sequence = 0
+        self._profile_lock = threading.Lock()
+        os.makedirs(self.checkpoint_dir, exist_ok=True)
+
+        try:
+            from torch.distributed.checkpoint import async_save
+        except ImportError:
+            self.native_async_save = None
+            self.implementation = "torch-2.1-compat"
+        else:
+            self.native_async_save = async_save
+            self.implementation = "native"
+
+        if self.rank == 0:
+            print(
+                f"[DCP_IMPLEMENTATION] {self.implementation}; "
+                f"torch={torch.__version__}; max_async={self.max_async}; "
+                f"thread_count={self.thread_count}"
+            )
+
+    def _profile(self, event, **fields):
+        if os.environ.get("PCCHECK_MS_PROFILE", "0") != "1":
+            return
+        path = os.environ.get("PCCHECK_MS_PROFILE_PATH")
+        if not path:
+            return
+        record = {
+            "ts": time.time(),
+            "event": event,
+            "pid": os.getpid(),
+            "rank": self.rank,
+            "run_id": os.environ.get("PCCHECK_MS_PROFILE_RUN_ID", ""),
+            "backend": "async_dcp",
+        }
+        record.update(fields)
+        try:
+            os.makedirs(os.path.dirname(path) or ".", exist_ok=True)
+            with self._profile_lock, open(path, "a", encoding="utf-8") as handle:
+                handle.write(json.dumps(record, sort_keys=True) + "\n")
+        except Exception:
+            pass
+
+    @staticmethod
+    def _optimizer_base(optimizer):
+        candidate = getattr(optimizer, "optimizer", None)
+        return candidate if candidate is not None and hasattr(candidate, "state") else optimizer
+
+    def _logical_3n_state(self, step):
+        module = self.model_engine.module
+        optimizer = self._optimizer_base(self.model_engine.optimizer)
+        names = {id(param): name for name, param in module.named_parameters()}
+        ordered_params = []
+        seen = set()
+        for group in optimizer.param_groups:
+            for param in group["params"]:
+                if id(param) not in seen:
+                    seen.add(id(param))
+                    ordered_params.append(param)
+
+        weights = {}
+        exp_avg = {}
+        exp_avg_sq = {}
+        optimizer_steps = {}
+        param_name_by_id = {}
+        for index, param in enumerate(ordered_params):
+            name = names.get(id(param), f"optimizer_param_{index:06d}")
+            param_name_by_id[id(param)] = name
+            state = optimizer.state.get(param, {})
+            if "exp_avg" not in state or "exp_avg_sq" not in state:
+                raise RuntimeError(
+                    f"DCP 3N state incomplete for {name}: Adam moments are not initialized"
+                )
+            weights[name] = param.detach()
+            exp_avg[name] = state["exp_avg"].detach()
+            exp_avg_sq[name] = state["exp_avg_sq"].detach()
+            optimizer_steps[name] = state.get("step", 0)
+
+        optimizer_param_groups = []
+        for group in optimizer.param_groups:
+            serialized_group = {
