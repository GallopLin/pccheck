+        return (time.perf_counter() - wait_start) * 1000.0
+
+    def _compat_save(self, staged_state, writer, checkpoint_id, submit_time):
+        save_start = time.perf_counter()
+        metadata = self.save_state_dict(
+            staged_state,
+            storage_writer=writer,
+            process_group=self.process_group,
+        )
+        save_ms = (time.perf_counter() - save_start) * 1000.0
+        total_ms = (time.perf_counter() - submit_time) * 1000.0
+        print(
+            f"Checkpoint {checkpoint_id} completed in background: "
+            f"{total_ms / 1000.0:.2f}s (DCP durable save {save_ms / 1000.0:.2f}s)"
+        )
+        self._profile(
+            "checkpoint_finalize",
+            checkpoint_id=checkpoint_id,
+            total_ms=total_ms,
+            sync_ms=save_ms,
+            implementation=self.implementation,
+        )
+        return metadata
