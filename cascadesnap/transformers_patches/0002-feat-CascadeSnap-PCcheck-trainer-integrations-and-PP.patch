+        slot = checkpoint_id % self.max_async
+        checkpoint_path = os.path.join(self.checkpoint_dir, f"slot_{slot}")
+
+        state, logical_bytes, weight_numel = self._logical_3n_state(step)
+        submit_time = time.perf_counter()
+        stage_start = time.perf_counter()
+        writer = self.FileSystemWriter(
+            checkpoint_path,
+            single_file_per_rank=True,
+            sync_files=True,
+            thread_count=self.thread_count,
+        )
+        if self.native_async_save is None:
+            staged_state = self._stage_to_cpu(state)
+            stage_ms = (time.perf_counter() - stage_start) * 1000.0
+            future = self.executor.submit(
+                self._compat_save,
+                staged_state,
+                writer,
+                checkpoint_id,
+                submit_time,
+            )
+        else:
+            future = self.native_async_save(
+                state,
+                storage_writer=writer,
+                process_group=self.process_group,
+            )
+            stage_ms = (time.perf_counter() - stage_start) * 1000.0
+
+            def native_done(done_future):
+                total_ms = (time.perf_counter() - submit_time) * 1000.0
+                done_future.result()
+                print(
+                    f"Checkpoint {checkpoint_id} completed in background: "
+                    f"{total_ms / 1000.0:.2f}s"
+                )
+                self._profile(
+                    "checkpoint_finalize",
+                    checkpoint_id=checkpoint_id,
+                    total_ms=total_ms,
+                    sync_ms=max(0.0, total_ms - stage_ms),
+                    implementation=self.implementation,
+                )
+
+            future.add_done_callback(native_done)
+
+        self.pending.append(future)
+        self._profile(
+            "begin_checkpoint",
